+    /// pushir: keep `data` for `dst` and tell its connection, if it has one, which
+    /// hands it over and asks for a pong. Of a mailbox's own 64 the oldest makes
+    /// way; when all 65,536 are taken, the oldest held anywhere does.
+    fn hold(&self, dst: EndpointId, src: EndpointId, mut data: Datagrams) {
+        // Its own bytes: a slice would keep the whole websocket read it came in.
+        data.contents = Bytes::copy_from_slice(&data.contents);
+        let mut q = self.0.held.entry(dst).or_default();
+        if q.len() >= HOLD.0 && q.pop_front().is_some() {
+            self.0.held_n.fetch_sub(1, Relaxed);
+        }
+        let n = self.0.held_seq.fetch_add(1, Relaxed);
+        q.push_back((n, Instant::now(), src, data));
+        drop(q);
+        let mut order = self.0.order.lock().expect("poisoned");
+        order.push_back((n, dst));
+        if self.0.held_n.fetch_add(1, Relaxed) >= HOLD.1 {
+            self.evict(&mut order);
+        }
+        if order.len() > 2 * HOLD.1 {
+            order.retain(|(n, dst)| {
+                let q = self.0.held.get(dst);
+                q.is_some_and(|q| q.front().is_some_and(|h| h.0 <= *n))
+            });
+        }
+        drop(order);
