+
+    /// pushir: drop the oldest frame held, by `order`. A mailbox's frames go from
+    /// its front alone, so number `n` is still held while its front is no newer.
+    fn evict(&self, order: &mut VecDeque<(u64, EndpointId)>) {
+        while let Some((n, dst)) = order.pop_front() {
+            let Some(mut q) = self.0.held.get_mut(&dst) else {
+                continue;
+            };
+            if q.front().is_some_and(|h| h.0 <= n) {
+                q.pop_front();
+                self.0.held_n.fetch_sub(1, Relaxed);
