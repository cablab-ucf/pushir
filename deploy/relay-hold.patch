+    /// pushir: keep `data` for `dst` and tell its connection, if it has one, which
+    /// hands it over and asks for a pong. A connected mailbox takes 64 at once
+    /// and one a second after (the rest is dropped); of a mailbox's own 64 the
+    /// oldest makes way; when all 65,536 are taken, a mailbox holding none is
+    /// handed the frame unkept, as a stock relay would.
+    fn hold(&self, dst: EndpointId, src: EndpointId, data: Datagrams) {
+        let client = self.0.clients.get(&dst);
+        if client.as_ref().is_some_and(|c| !c.active.hint_budget()) {
+            return;
+        }
+        if self.0.held_n.load(Relaxed) >= HOLD.1 {
+            self.sweep();
+        }
+        let full = self.0.held_n.load(Relaxed) >= HOLD.1;
+        let mut q = match self.0.held.entry(dst) {
+            dashmap::Entry::Occupied(e) => e.into_ref(),
+            dashmap::Entry::Vacant(_) if full => {
+                if let Some(c) = client {
+                    c.active.try_send_packet(src, data).ok();
