+/// irpush: 204 if the bearer key lifts the rate limit here, else 403.
+fn key_handler(r: Request<Incoming>, response: ResponseBuilder) -> HyperResult<Response<BytesBody>> {
+    let ok = http_server::unlimited(r.headers());
+    response
+        .status(if ok { StatusCode::NO_CONTENT } else { StatusCode::FORBIDDEN })
+        .body(body_empty())
+        .map_err(|err| Box::new(err) as HyperError)
+}
 
