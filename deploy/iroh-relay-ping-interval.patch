+        let clients = Clients::default();
+        clients.register(config, Arc::new(Metrics::default()));
+
+        let early = tokio::time::timeout(Duration::from_secs(3590), rw.next()).await;
+        assert!(early.is_err(), "pinged before the interval");
+        let ping = recv_frame(FrameType::Ping, &mut rw);
+        let frame = tokio::time::timeout(Duration::from_secs(20), ping).await.anyerr()??;
+        assert!(matches!(frame, RelayToClientMsg::Ping(_)));
+
+        clients.shutdown().await;
+        Ok(())
+    }
